# Frontend build-time settings (Vite). Copy to .env.local for local overrides.

# API base. Defaults to /api, which Vite proxies to http://127.0.0.1:8000 in dev
# and vercel.json rewrites to the Render backend in production.
# VITE_API_URL=/api

# Portal URLs (defaults are the production domains in src/config/portal.ts).
# VITE_LANDING_URL=https://nubianfit.xn--jhb4c.com
# VITE_COACH_URL=https://coach.nubianfit.xn--jhb4c.com
# VITE_CLIENT_URL=https://app.nubianfit.xn--jhb4c.com
