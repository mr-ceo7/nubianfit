# Copy to backend/.env for local development. Production values live in Render (see render.yaml).

# development | production
ENVIRONMENT=development
# Seed demo coach + clients on startup (dev only). Demo coach: coach@nubianfit.com / Coach@123
ENABLE_DEV_SEED=true

# Defaults to SQLite at backend/nubianfit.db. Production requires Postgres.
# DATABASE_URL=postgresql://user:pass@host:5432/nubianfit

# Production requires 32+ random characters.
# SECRET_KEY=

# Private code new coaches need to sign up. Production requires 16+ characters.
# COACH_INVITE_CODE=

# Resend (https://resend.com). Without a key, emails (including client login codes) are printed to the server log.
# RESEND_API_KEY=
# FROM_EMAIL=NubianFit <no-reply@your-verified-domain>

# First production deploy only: creates the head coach from these values, then set back to false.
# BOOTSTRAP_INITIAL_ADMIN=false
# DEFAULT_COACH_NAME=
# DEFAULT_COACH_EMAIL=
# DEFAULT_COACH_PASSWORD=

# USDA FoodData Central key (free: https://fdc.nal.usda.gov/api-key-signup). DEMO_KEY is rate limited.
# FDC_API_KEY=DEMO_KEY

# Web push. Generate a pair with: ./venv/bin/python scripts/generate_vapid_keys.py (push is off when unset).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain

# Lets an external cron call POST /api/internal/tick (header X-Cron-Token) to run Autoflow steps,
# check-in reminders and email digests when the server has been asleep.
# CRON_TOKEN=

# Paystack (test keys until launch). Webhook URL to set in the Paystack dashboard:
#   https://<your domain>/api/webhooks/paystack
# PAYSTACK_SECRET_KEY=sk_test_...
# PLATFORM_FEE_PERCENT=0
# Platform admins: the bootstrapped head coach is one; grant others with
#   ./venv/bin/python scripts/make_admin.py someone@example.com

# Comma-separated extra allowed origins, e.g. Vercel preview URLs.
# EXTRA_CORS_ORIGINS=
