# Copy to backend/.env for local development. Production values live in Render (see render.yaml).

# development | production
ENVIRONMENT=development
# Seed demo coach + clients on startup (dev only). Demo coach: coach@nubianfit.com / Coach@123
ENABLE_DEV_SEED=true

# Defaults to SQLite at backend/nubianfit.db. Production requires Postgres.
# DATABASE_URL=postgresql://user:pass@host:5432/nubianfit

# Production requires 32+ random characters.
# SECRET_KEY=

# Private code new coaches need to sign up. Production requires 16+ characters.
# COACH_INVITE_CODE=

# Resend (https://resend.com). Without a key, emails (including client login codes) are printed to the server log.
# RESEND_API_KEY=
# FROM_EMAIL=NubianFit <no-reply@your-verified-domain>

# First production deploy only: creates the head coach from these values, then set back to false.
# BOOTSTRAP_INITIAL_ADMIN=false
# DEFAULT_COACH_NAME=
# DEFAULT_COACH_EMAIL=
# DEFAULT_COACH_PASSWORD=

# Comma-separated extra allowed origins, e.g. Vercel preview URLs.
# EXTRA_CORS_ORIGINS=
